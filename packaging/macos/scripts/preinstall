#!/bin/bash
# Remove an older Avel Ess of the same kind so the new one replaces it cleanly.
# $1 is the path of the component package being installed.
if [ "$(basename "$1")" = "AvelEss-VST3.pkg" ]; then
    rm -rf "/Library/Audio/Plug-Ins/VST3/Avel Ess.vst3"
elif [ "$(basename "$1")" = "AvelEss-AU.pkg" ]; then
    rm -rf "/Library/Audio/Plug-Ins/Components/Avel Ess.component"
fi
exit 0
